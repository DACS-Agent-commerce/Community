{
  "name": "dacs-directory",
  "version": "0.1.0",
  "private": true,
  "description": "DACS Directory \u2014 community catalog (\u00a76.3.6 API), agent registry UI, and in-browser deal verification for the DACS agent-commerce standard.",
  "license": "MIT",
  "scripts": {
    "setup": "bash scripts/setup-sdk.sh",
    "dev": "next dev -p 3400",
    "build": "next build",
    "start": "next start -p ${PORT:-3400}",
    "start:railway": "bash scripts/start-railway.sh",
    "check:deploy-config": "node scripts/check-directory-origin.mjs",
    "check:node-runtime": "node scripts/check-node-runtime.mjs",
    "verify:origin-sources": "node scripts/verify-origin-sources.mjs",
    "check:node": "tsx scripts/check-node-contract.ts",
    "check:node-deployment": "tsx scripts/check-node-deployment.ts",
    "check:listing-upgrade": "tsx scripts/check-live-listing-upgrade.ts",
    "test": "tsx --test test/*.test.ts test/*.test.mjs",
    "test:e2e": "playwright test e2e/home.spec.ts e2e/register.spec.ts",
    "test:e2e:ui": "playwright test --ui",
    "test:seed": "tsx --test test/seed-smoke.test.ts",
    "index": "tsx src/catalog/reindex.ts",
    "seed:counterparty-fixture": "tsx scripts/seed-counterparty-fixture.ts",
    "typecheck": "tsc --noEmit",
    "prepack": "node scripts/source-release-only.mjs"
  },
  "engines": {
    "node": "22.23.3"
  },
  "dependencies": {
    "@fontsource-variable/plus-jakarta-sans": "5.3.0",
    "@fontsource-variable/source-code-pro": "5.3.1",
    "@noble/ed25519": "^2.3.0",
    "@noble/hashes": "^1.8.0",
    "better-sqlite3": "^11.10.0",
    "buffer": "^6.0.3",
    "next": "^15.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsx": "^4.19.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^5.6.3"
  },
  "overrides": {
    "postcss": "^8.5.10"
  },
  "type": "module"
}
