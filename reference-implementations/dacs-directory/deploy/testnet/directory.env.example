# DACS Directory testnet deployment settings. Copy to /etc/dacs-directory/directory.env
# (owner root, group dacs-directory, mode 0640) and replace every example.org value.
# The startup check requires the testnet label, matching credential-free HTTPS
# RPCs without mainnet host labels, and the node-reported pinned chain.
# The units also check the compiled manifest's RPC with --built.
# These checks do not authenticate the node or prove the pinned chain is the testnet.
DACS_DIRECTORY_NETWORK=testnet

# Demos testnet RPC for the server and the indexer, and the one browsers use to
# verify deals (built into the pages, so build with this file loaded too).
DEMOS_RPC=https://rpc.testnet.example.org
NEXT_PUBLIC_DEMOS_RPC=https://rpc.testnet.example.org

# Leave unset to use the pinned chain. A value must be an accepted chain
# identity (src/catalog/testnetDeployment.ts); anything else is refused.
#DEMOS_CHAIN_IDENTITY=

# Public origin of this Directory.
NEXT_PUBLIC_DIRECTORY_URL=https://directory.example.org

DACS_DIRECTORY_DATA=/var/lib/dacs-directory
PORT=3400

# Caddy sets X-Forwarded-For to the client address.
DACS_TRUST_PROXY=1

# The timer's interval, so the status endpoint's stall threshold matches it.
DACS_INDEX_INTERVAL_SECONDS=300

# Bearer token for the admin routes (index-now, reindex). Generate a long random
# value on the server; never commit it.
DACS_ADMIN_TOKEN=
