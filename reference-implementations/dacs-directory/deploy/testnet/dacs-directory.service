# DACS Directory web server, Demos testnet only. See DEPLOY-TESTNET.md.
[Unit]
Description=DACS Directory (testnet)
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=dacs-directory
Group=dacs-directory
WorkingDirectory=/opt/dacs-directory/reference-implementations/dacs-directory
EnvironmentFile=/etc/dacs-directory/directory.env
ExecStartPre=/usr/bin/env node scripts/check-node-runtime.mjs
# Refuses any network but the testnet and any chain but the pinned testnet chain.
ExecStartPre=/usr/bin/env npm run --silent check:testnet -- --built
ExecStart=/usr/bin/env node node_modules/next/dist/bin/next start --hostname 127.0.0.1 --port ${PORT}
Restart=on-failure
RestartSec=30
StateDirectory=dacs-directory
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
