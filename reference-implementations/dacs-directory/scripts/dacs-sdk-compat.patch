+function legacySignatureValue(value: unknown): string | null {
+  if (typeof value !== "string") return null;
+  const hex = /^(?:0x)?([0-9a-f]{128})$/i.exec(value)?.[1];
+  if (hex !== undefined) return Buffer.from(hex, "hex").toString("base64url");
+  // 64 bytes is exactly 86 unpadded Base64URL characters; re-encoding must round-trip.
+  return /^[A-Za-z0-9_-]{86}$/.test(value) && Buffer.from(value, "base64url").toString("base64url") === value
+    ? value
+    : null;
+}
