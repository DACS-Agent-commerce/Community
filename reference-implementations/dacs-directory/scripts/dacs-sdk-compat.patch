+/** Decode only the frozen historical SDK profile's signature spellings. */
+function legacySignatureValue(value: unknown): string | null {
+  if (typeof value !== "string") return null;
+  if (/^(?:0x)?[0-9a-fA-F]{128}$/.test(value)) return Buffer.from(value.replace(/^0x/, ""), "hex").toString("base64url");
